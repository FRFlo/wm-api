{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": [],
	"categories": {
		"correctness": "warn"
	},
	"env": {
		"builtin": true,
		"node": true
	},
	"ignorePatterns": [
		"**/.DS_Store",
		"**/node_modules",
		"**/.env",
		"**/.env.*",
		"!**/.env.example",
		"**/dist",
		"**/*.local"
	]
}
